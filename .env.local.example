# Variables de entorno (copiar a .env.local). Todas también deben existir en Vercel (Production).
# El contenido del sitio público vive en Neon; el panel /admin se accede con la cuenta del Portal (modulos_acceso: contenido_sitio).

# Neon Postgres (Portal PINE + sitio público)
DATABASE_URL=

# Firma de la cookie httpOnly pine_app_session (lib/session.ts). Sin fallback.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Cloudinary (app/api/upload, fotos/evidencias)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Subida de video/podcast a YouTube (app/api/youtube/**, lib/youtube.ts)
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# IA para /utilidades y redacción de difusión — app/utilidades/_lib/groq.ts
GROQ_API_KEY=
